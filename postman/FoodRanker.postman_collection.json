      "name": "01 - Auth Service",
      "item": [
        {
          "name": "00 - Health Check and Setup",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "exec": [
                  "const runId = Date.now();\r",
                  "\r",
                  "pm.environment.set(\"runId\", runId);\r",
                  "pm.environment.set(\"adminEmail\", `admin.${runId}@foodranker.test`);\r",
                  "pm.environment.set(\"unknownEmail\", `unknown.${runId}@foodranker.test`);\r",
                  "\r",
                  "pm.environment.unset(\"adminId\");\r",
                  "pm.environment.unset(\"adminToken\");"
                ],
                "type": "text/javascript",
                "packages": {},
                "requests": {}
              }
            },
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Debe responder 200\", function () {\r",
                  "  pm.response.to.have.status(200);\r",
                  "});\r",
                  "\r",
                  "pm.test(\"Debe responder status ok\", function () {\r",
                  "  const json = pm.response.json();\r",
                  "  pm.expect(json.status).to.eql(\"ok\");\r",
                  "});"
                ],
                "type": "text/javascript",
                "packages": {},
                "requests": {}
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{authBaseUrl}}/health",
              "host": [
                "{{authBaseUrl}}"
              ],
              "path": [
                "health"
              ]
            }
          },
          "response": []
        },
        {
          "name": "01 - Register Admin Successfully",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "exec": [
                  ""
                ],
                "type": "text/javascript",
                "packages": {},
                "requests": {}
              }
            },
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Debe responder 201\", function () {\r",
                  "  pm.response.to.have.status(201);\r",
                  "});\r",
                  "\r",
                  "pm.test(\"Debe regresar datos del admin\", function () {\r",
                  "  const json = pm.response.json();\r",
                  "\r",
                  "  pm.expect(json).to.have.property(\"id\");\r",
                  "  pm.expect(json.email).to.eql(pm.environment.get(\"adminEmail\"));\r",
                  "  pm.expect(json.role).to.eql(\"admin\");\r",
                  "  pm.expect(json.emailVerified).to.eql(true);\r",
                  "\r",
                  "  pm.environment.set(\"adminId\", json.id);\r",
                  "});"
                ],
                "type": "text/javascript",
                "packages": {},
                "requests": {}
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json",
                "type": "text"
              },
              {
                "key": "x-admin-secret",
                "value": "{{adminSecret}}",
                "type": "text"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\r\n  \"email\": \"{{adminEmail}}\",\r\n  \"password\": \"{{testPassword}}\"\r\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{authBaseUrl}}/register/admin",
              "host": [
                "{{authBaseUrl}}"
              ],
              "path": [
                "register",
                "admin"
              ]
            }
